  "gap_analysis_framework": {
    "P0_gaps": {
      "severity": "CRITICAL",
      "action": "Flag as submission-blocking issue",
      "examples": [
        "Missing NOAEL from repeat-dose toxicity",
        "No hERG safety pharmacology study",
        "Incomplete genotoxicity battery",
        "Missing single-dose toxicity in required species"
      ]
    },
    "P1_gaps": {
      "severity": "MAJOR",
      "action": "Evaluate based on context (drug class, indication, phase)",
      "decision_tree": {
        "embryo_fetal_dev": "Required if WCBP included in clinical study",
        "fertility_study": "Required if WCBP included in clinical study",
        "local_tolerance": "Required if non-oral route",
        "immunotoxicity": "Required if immunomodulatory effects observed"
      }
    },
    "P2_gaps": {
      "severity": "MINOR",
      "action": "Document as future requirement for NDA",
      "examples": [
        "Carcinogenicity studies (deferred to NDA)",
        "PPND study (deferred to NDA)",
        "Juvenile animal studies (only if pediatric population)"
      ]
    }
  }
}
