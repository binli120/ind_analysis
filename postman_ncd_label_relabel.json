{
  "info": {
    "_postman_id": "8a8c4a8e-8f97-4cce-9a71-2c7969c8f9df",
    "name": "NCD Labeling APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for labeling and relabeling Module 4 PDFs via the /ncd endpoints."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "bucket",
      "value": "YOUR_BUCKET"
    },
    {
      "key": "company",
      "value": "filynai.com"
    },
    {
      "key": "project",
      "value": "LT1009"
    },
    {
      "key": "awsRegion",
      "value": "us-east-1"
    }
  ],
  "item": [
    {
      "name": "Label PDF (S3)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bucket\": \"{{bucket}}\",\n  \"key\": \"filynai.com/LT1009/Module 4/example.pdf\",\n  \"company\": \"{{company}}\",\n  \"project\": \"{{project}}\",\n  \"page_limit\": 5,\n  \"use_llm\": false,\n  \"aws_region\": \"{{awsRegion}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ncd/label",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "label"
          ]
        },
        "description": "Label an S3 PDF using minimal page sampling. Copies the file into company/project/<section>/filename and updates metadata sidecars."
      }
    },
    {
      "name": "Relabel PDF (S3)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"bucket\": \"{{bucket}}\",\n  \"key\": \"filynai.com/LT1009/Module 4/example.pdf\",\n  \"company\": \"{{company}}\",\n  \"project\": \"{{project}}\",\n  \"section_number\": \"4.2.1.1\",\n  \"section_title\": \"Primary Pharmacodynamics\",\n  \"aws_region\": \"{{awsRegion}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ncd/relabel",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "relabel"
          ]
        },
        "description": "Manually correct a section assignment: moves the PDF to company/project/<section>/filename and updates metadata + sidecars."
      }
    }
  ]
}
