{
  "info": {
    "_postman_id": "d4f1d3c6-8c9e-4c97-baa7-b2d4e8df8c4f",
    "name": "NCD Assets APIs",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for the /ncd/assets endpoints (tables, images, summary/conclusion passages)."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "tenant_id",
      "value": "YOUR_TENANT_ID"
    },
    {
      "key": "project_id",
      "value": "YOUR_PROJECT_ID"
    },
    {
      "key": "bucket",
      "value": "doc-repository-dev"
    },
    {
      "key": "section",
      "value": "2.6.6.2"
    },
    {
      "key": "limit",
      "value": "200"
    },
    {
      "key": "content_type",
      "value": "summary"
    },
    {
      "key": "element",
      "value": "2.4.5-a"
    },
    {
      "key": "summary_id",
      "value": ""
    },
    {
      "key": "tabulated_id",
      "value": ""
    },
    {
      "key": "previous_summary_id",
      "value": ""
    },
    {
      "key": "previous_tabulated_id",
      "value": ""
    },
    {
      "key": "user_prompt",
      "value": ""
    },
    {
      "key": "user_comment",
      "value": ""
    },
    {
      "key": "use_llm",
      "value": "true"
    },
    {
      "key": "final_text",
      "value": ""
    },
    {
      "key": "final_payload",
      "value": "{\n  \"section\": \"{{section}}\",\n  \"tables\": []\n}"
    }
  ],
  "item": [
    {
      "name": "CTD 2.4 Element Reference",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ncd/ctd/2.4/element?element={{element}}&tenant_id={{tenant_id}}&project_id={{project_id}}&bucket={{bucket}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "ctd",
            "2.4",
            "element"
          ],
          "query": [
            {
              "key": "element",
              "value": "{{element}}"
            },
            {
              "key": "tenant_id",
              "value": "{{tenant_id}}"
            },
            {
              "key": "project_id",
              "value": "{{project_id}}"
            },
            {
              "key": "bucket",
              "value": "{{bucket}}"
            }
          ]
        },
        "description": "Fetch cached data for a 2.4 element (template + sources + assets)."
      }
    },
    {
      "name": "Assets - Images",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/image?section={{section}}&tenant_id={{tenant_id}}&project_id={{project_id}}&bucket={{bucket}}&limit={{limit}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "image"
          ],
          "query": [
            {
              "key": "section",
              "value": "{{section}}"
            },
            {
              "key": "tenant_id",
              "value": "{{tenant_id}}"
            },
            {
              "key": "project_id",
              "value": "{{project_id}}"
            },
            {
              "key": "bucket",
              "value": "{{bucket}}"
            },
            {
              "key": "limit",
              "value": "{{limit}}"
            }
          ]
        },
        "description": "Fetch image assets for a CTD 2.4/2.6 section. Returns asset links + context."
      }
    },
    {
      "name": "Assets - Tables",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/table?section={{section}}&tenant_id={{tenant_id}}&project_id={{project_id}}&bucket={{bucket}}&limit={{limit}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "table"
          ],
          "query": [
            {
              "key": "section",
              "value": "{{section}}"
            },
            {
              "key": "tenant_id",
              "value": "{{tenant_id}}"
            },
            {
              "key": "project_id",
              "value": "{{project_id}}"
            },
            {
              "key": "bucket",
              "value": "{{bucket}}"
            },
            {
              "key": "limit",
              "value": "{{limit}}"
            }
          ]
        },
        "description": "Fetch table assets for a CTD 2.4/2.6 section. Returns CSV/JSON links + context."
      }
    },
    {
      "name": "Assets - Contents (Summary/Conclusion)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/contents?section={{section}}&tenant_id={{tenant_id}}&project_id={{project_id}}&bucket={{bucket}}&content_type={{content_type}}&include_assets=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "contents"
          ],
          "query": [
            {
              "key": "section",
              "value": "{{section}}"
            },
            {
              "key": "tenant_id",
              "value": "{{tenant_id}}"
            },
            {
              "key": "project_id",
              "value": "{{project_id}}"
            },
            {
              "key": "bucket",
              "value": "{{bucket}}"
            },
            {
              "key": "content_type",
              "value": "{{content_type}}"
            },
            {
              "key": "include_assets",
              "value": "true"
            }
          ]
        },
        "description": "Return summary/conclusion passages with linked assets for a CTD section."
      }
    },
    {
      "name": "Assets - Section Summary (Draft)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"section\": \"{{section}}\",\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"project_id\": \"{{project_id}}\",\n  \"bucket\": \"{{bucket}}\",\n  \"user_prompt\": \"{{user_prompt}}\",\n  \"user_comment\": \"{{user_comment}}\",\n  \"previous_summary_id\": \"{{previous_summary_id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/summary",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "summary"
          ]
        },
        "description": "Generate a draft summary for a CTD section using template + source data."
      }
    },
    {
      "name": "Assets - Section Summary (Approve)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"project_id\": \"{{project_id}}\",\n  \"bucket\": \"{{bucket}}\",\n  \"summary_id\": \"{{summary_id}}\",\n  \"section\": \"{{section}}\",\n  \"final_text\": \"{{final_text}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/summary/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "summary",
            "approve"
          ]
        },
        "description": "Approve a draft summary with final text for a CTD section."
      }
    },
    {
      "name": "Assets - Tabulated Summary (Draft)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"section\": \"{{section}}\",\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"project_id\": \"{{project_id}}\",\n  \"bucket\": \"{{bucket}}\",\n  \"use_llm\": {{use_llm}},\n  \"user_prompt\": \"{{user_prompt}}\",\n  \"user_comment\": \"{{user_comment}}\",\n  \"previous_tabulated_id\": \"{{previous_tabulated_id}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/tabulated",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "tabulated"
          ]
        },
        "description": "Generate a draft tabulated summary for a CTD 2.6 section."
      }
    },
    {
      "name": "Assets - Tabulated Summary (Approve)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"tenant_id\": \"{{tenant_id}}\",\n  \"project_id\": \"{{project_id}}\",\n  \"bucket\": \"{{bucket}}\",\n  \"summary_id\": \"{{tabulated_id}}\",\n  \"section\": \"{{section}}\",\n  \"final_payload\": {{final_payload}}\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/ncd/assets/tabulated/approve",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "assets",
            "tabulated",
            "approve"
          ]
        },
        "description": "Approve a draft tabulated summary with final tables."
      }
    }
  ]
}
