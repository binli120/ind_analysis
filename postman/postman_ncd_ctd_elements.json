{
  "info": {
    "_postman_id": "d2d3c2c5-5b62-4f1b-9d0f-84f5c5c5c2c1",
    "name": "NCD CTD 2.4 Elements",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Postman collection for the /ncd/ctd/2.4/element endpoint."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8000"
    },
    {
      "key": "tenant_id",
      "value": "YOUR_TENANT_ID"
    },
    {
      "key": "project_id",
      "value": "YOUR_PROJECT_ID"
    },
    {
      "key": "bucket",
      "value": "doc-repository-dev"
    },
    {
      "key": "element",
      "value": "2.4.5-a"
    }
  ],
  "item": [
    {
      "name": "CTD 2.4 Element Reference",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ncd/ctd/2.4/element?element={{element}}&tenant_id={{tenant_id}}&project_id={{project_id}}&bucket={{bucket}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "ctd",
            "2.4",
            "element"
          ],
          "query": [
            {
              "key": "element",
              "value": "{{element}}"
            },
            {
              "key": "tenant_id",
              "value": "{{tenant_id}}"
            },
            {
              "key": "project_id",
              "value": "{{project_id}}"
            },
            {
              "key": "bucket",
              "value": "{{bucket}}"
            }
          ]
        },
        "description": "Fetch cached data for a 2.4 element (template + sources + assets)."
      }
    },
    {
      "name": "CTD 2.4 Element Reference (Refresh)",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/ncd/ctd/2.4/element?element={{element}}&tenant_id={{tenant_id}}&project_id={{project_id}}&bucket={{bucket}}&refresh=true",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "ncd",
            "ctd",
            "2.4",
            "element"
          ],
          "query": [
            {
              "key": "element",
              "value": "{{element}}"
            },
            {
              "key": "tenant_id",
              "value": "{{tenant_id}}"
            },
            {
              "key": "project_id",
              "value": "{{project_id}}"
            },
            {
              "key": "bucket",
              "value": "{{bucket}}"
            },
            {
              "key": "refresh",
              "value": "true"
            }
          ]
        },
        "description": "Rebuild and overwrite the cached payload for a 2.4 element."
      }
    }
  ]
}
