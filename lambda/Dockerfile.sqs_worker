FROM public.ecr.aws/lambda/python:3.11

# Copy dependency manifest generated by Poetry export
COPY build/requirements.txt /tmp/requirements.txt

# Build deps for packages that need compilation (e.g., numpy)
RUN yum install -y gcc gcc-c++ make && yum clean all

RUN pip install -r /tmp/requirements.txt

# Copy application code
COPY src ./src
COPY lambda/sqs_worker.py .

CMD ["sqs_worker.handler"]
