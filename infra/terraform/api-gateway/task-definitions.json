{
    "family": "pdf-analysis-task",
    "networkMode": "awsvpc",
    "requiresCompatibilities": [
        "FARGATE"
    ],
    "cpu": "256",
    "memory": "512",
    "executionRoleArn": "arn:aws:iam::977684304019:role/ecsTaskExecutionRole",
    "containerDefinitions": [
        {
            "name": "pdf-analysis-container",
            "image": "977684304019.dkr.ecr.us-east-1.amazonaws.com/filynai-dev/repository:pdf-analysis",
            "essential": true,
            "portMappings": [
                {
                    "containerPort": 8080,
                    "protocol": "tcp"
                }
            ],
            "environment": [
                {
                    "name": "PORT",
                    "value": "8080"
                }
            ]
        }
    ]
}
